{
  "name": "obsidian-google-places",
  "version": "1.7.0",
  "description": "Search for places using Google Places API and create structured notes in Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run test:ci && npm run typecheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "release": "bash release.sh"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "google-places",
    "restaurants"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.10.0",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "^4.0.15",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.19.8",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.0.15"
  }
}
